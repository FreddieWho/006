# Large local data and historical result stores
data/
tmp/
logs/
mvp/
auditpack/
.auditpack/

# Results are local by default. Only the v7 control-plane files below are tracked.
results/**
!results/v7/
!results/v7/README.md
!results/v7/STATUS.md
!results/v7/inheritance/
!results/v7/inheritance/asset_manifest.tsv
!results/v7/inheritance/reset_manifest.yaml

